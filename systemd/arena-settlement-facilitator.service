[Unit]
Description=Arena settlement facilitator (optional settlement courier)
Documentation=file:/opt/arena-settlement-facilitator/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/arena-settlement-facilitator
Environment=SF_CONFIG=/etc/arena-settlement-facilitator/config.json
# Optional: a stable courier key for the kind-1452 `p` tag. It authors nothing
# authoritative, so leaving it unset (ephemeral key) is fine.
# EnvironmentFile=-/etc/arena-settlement-facilitator/env
ExecStart=/home/%u/.bun/bin/bun src/index.ts
# ALWAYS, not on-failure: the 2026-11-24 incident was a clean exit (status 0),
# which `on-failure` does not restart. A signalled shutdown exits 130/143 by
# contract (src/index.ts), and this unit restarts it regardless.
Restart=always
RestartSec=5
# The heartbeat snapshot the liveness monitor reads; %S is the user state dir.
StateDirectory=arena-settlement-facilitator
StateDirectoryMode=0750
Environment=SF_STATE_FILE=%S/arena-settlement-facilitator/state.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%S/arena-settlement-facilitator

[Install]
WantedBy=default.target